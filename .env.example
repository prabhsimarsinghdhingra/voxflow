# Copy to .env and edit. run.ps1 loads it automatically.
# --- LLM server: pick ONE ---
# vLLM (WSL2/Linux/Docker, NVIDIA GPU):   vllm serve Qwen/Qwen2.5-1.5B-Instruct --port 8001
VLLM_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Ollama (native Windows, CPU or GPU):    ollama pull qwen2.5:1.5b
# VLLM_URL=http://localhost:11434/v1
# VLLM_MODEL=qwen2.5:1.5b
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://vox:vox@localhost:5432/vox
